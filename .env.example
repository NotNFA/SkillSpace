# Copy this file to .env and fill values locally. Never commit .env.
PORT=
JWT_SECRET=
DATABASE_URL=
CLIENT_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=
AI_REQUEST_TIMEOUT_MS=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Optional fallback only; normal meetings use the original scheduler email as host.
# Optional fallback only; normal meetings use the original scheduler email as host.
ZOOM_HOST_USER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PGSSLMODE=require
PG_POOL_MAX=5

# Comma-separated email addresses allowed to access the separate SkillSpace Admin Panel.
ADMIN_EMAILS=admin@example.com
