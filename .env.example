PORT=3000
# Optional absolute path for persistent SQLite storage
# DATABASE_PATH=C:/CreatrHub/data/creatrhub.db
JWT_SECRET=replace-with-a-long-random-secret

# Zoom Server-to-Server OAuth (keep real values in your local .env only)
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_HOST_USER=me

# Public frontend origin for Socket.IO (set this in production)
CLIENT_URL=http://localhost:3000

# Optional AI requirement verification (keep secret server-side)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional parallel review providers (keys stay on the backend only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://your-domain.example
AI_REQUEST_TIMEOUT_MS=35000

# Payment gateway credentials are added when marketplace payout approval is obtained.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Optional creator reputation weights (must be JSON; defaults total 100)
# CREATOR_REPUTATION_WEIGHTS={"requirementMatch":30,"onTimeDelivery":25,"milestoneCompletion":20,"clientSatisfaction":15,"projectQuality":10}
